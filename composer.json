{
    "name": "liberusoftware/ecommerce-dropshipping-livewire",
    "description": "The shopper's side of Dropshipping: what has been despatched of their own order, when it was promised, and the carrier references a supplier reported — and never who supplies it or what the merchant paid.",
    "type": "liberu-module",
    "license": "MIT",
    "version": "0.1.0",
    "keywords": ["laravel", "livewire", "ecommerce", "dropshipping", "despatch", "tracking", "liberu"],
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "liberusoftware/ecommerce-dropshipping": "^0.1",
        "livewire/livewire": "^4.2"
    },
    "require-dev": {
        "liberusoftware/package-testbench": "^1.7",
        "pestphp/pest": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Liberu\\Ecommerce\\Dropshipping\\Livewire\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Liberu\\Ecommerce\\Dropshipping\\Livewire\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/liberusoftware/module-ecommerce-dropshipping"
        }
    ],
    "extra": {
        "liberu": {
            "name": "ecommerce-dropshipping-livewire"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
